# Reference values only. Copy the relevant variables into each service's environment.
# Frontend (set at build time; use the deployed Spring Boot API in production)
VITE_API_URL=http://localhost:8080

# Spring Boot backend
DB_URL=jdbc:mysql://localhost:3306/fraud_dashboard?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=fraud_user
DB_PASSWORD=fraud_pass
ML_SERVICE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# FastAPI hosting port
PORT=8000
